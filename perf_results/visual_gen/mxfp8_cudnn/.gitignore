# Raw video frame tensors are large (10-200 MB each, ~1.7 GB total) and easily
# regenerated by re-running the eval scripts. Keep them out of git.
*.npy

# Full-default mp4s (~900 KB each, 81 frames @ 720x1280) exceed the
# pre-commit large-file limit (500 KB) and are regenerable from .npy via
# `compare_videos.py` / imageio. Step-sweep mp4s (9 frames @ 480x832,
# ~25-120 KB) are kept.
videos/*.mp4
